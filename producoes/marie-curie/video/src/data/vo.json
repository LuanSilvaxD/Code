 "end": 0.572}, {"text": "conhecia", "start": 0.583, "end": 1.049}, {"text": "o", "start": 1.061, "end": 1.095}, {"text": "perigo", "start": 1.106, "end": 1.436}, {"text": "da", "start": 1.447, "end": 1.538}, {"text": "radiação", "start": 1.549, "end": 2.14}, {"text": "Ela", "start": 2.92, "end": 3.124}, {"text": "manipulou", "start": 3.136, "end": 3.636}, {"text": "rádio", "start": 3.647, "end": 3.954}, {"text": "por", "start": 3.965, "end": 4.113}, {"text": "décadas", "start": 4.124, "end": 4.613}, {"text": "quase", "start": 4.818, "end": 5.147}, {"text": "sem", "start": 5.158, "end": 5.352}, {"text": "proteção", "start": 5.363, "end": 5.897}, {"text": "e", "start": 6.181, "end": 6.272}, {"text": "morreu", "start": 6.283, "end": 6.613}, {"text": "em", "start": 6.624, "end": 7.346}, {"text": "1934", "start": 7.346, "end": 8.068}, {"text": "de", "start": 8.079, "end": 8.147}, {"text": "uma", "start": 8.158, "end": 8.283}, {"text": "doença", "start": 8.295, "end": 8.715}, {"text": "no", "start": 8.727, "end": 8.818}, {"text": "sangue", "start": 8.829, "end": 9.204}, {"text": "provavelmente", "start": 9.454, "end": 10.147}, {"text": "causada", "start": 10.158, "end": 10.647}, {"text": "pela", "start": 10.658, "end": 10.852}, {"text": "radiação", "start": 10.863, "end": 11.454}, {"text": "O", "start": 12.238, "end": 12.374}, {"text": "rádio", "start": 12.386, "end": 12.727}, {"text": "ficou", "start": 12.738, "end": 13.011}, {"text": "até", "start": 13.022, "end": 13.249}, {"text": "nos", "start": 13.261, "end": 13.397}, {"text": "cadernos", "start": 13.408, "end": 13.874}, {"text": "dela", "start": 13.886, "end": 14.215}]}, "s15": {"text": "Ela nasceu Maria Sklodóvska. Mas o mundo a conhece como Marie Kirí.", "seconds": 4.321, "words": [{"text": "Ela", "start": 0, "end": 0.164}, {"text": "nasceu", "start": 0.177, "end": 0.46}, {"text": "Maria", "start": 0.472, "end": 0.756}, {"text": "Sklodóvska", "start": 0.768, "end": 1.414}, {"text": "Mas", "start": 2.194, "end": 2